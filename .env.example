# Origin API configuration (all optional — the API runs with sensible defaults).
# Copy to .env and export, or set in your process manager. No secrets required.

# LM scorer for the feature pipeline: stub (deterministic, offline), none,
# or hf:<checkpoint> (e.g. hf:distilgpt2 — downloads from the HF hub).
ORIGIN_SCORER=stub

# Directory containing trained classical artifacts (doc_baseline.json +
# sentence_baseline.json, produced by `origin train baseline --out <dir>`).
# When unset, demo detectors are trained at startup on the bundled sample corpus.
#ORIGIN_ARTIFACT_DIR=artifacts/baseline

# Optional neural checkpoint (path or hub id) to expose as the "neural" detector.
#ORIGIN_NEURAL_CHECKPOINT=artifacts/neural

# Override the demo-training corpus.
#ORIGIN_SAMPLE_DATASET=data/sample/documents.jsonl

# Comma-separated CORS origins for the web frontend.
#ORIGIN_CORS_ORIGINS=http://localhost:5173
